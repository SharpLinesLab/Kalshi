# btc15-trade-caller configuration. Copy to .env (gitignored) and fill in. NEVER commit real values.

# PAPER (default) | DEMO | LIVE
MODE=PAPER

# Required for every mode: HTTP basic auth on every dashboard route (>= 8 chars)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# Required for DEMO and LIVE. Demo and production keys are DIFFERENT and not interchangeable.
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# --- LIVE ONLY: the service refuses to start unless ALL of these are set ---
LIVE_CONFIRM=
DAILY_LOSS_LIMIT_USD=
MAX_TOTAL_LOSS_USD=
MAX_CONTRACTS_PER_TRADE=
# LIVE while proof status is UNPROVEN also needs ALLOW_UNPROVEN=yes (and is then forced to 1 contract/trade)
ALLOW_UNPROVEN=

# Optional: Discord alerts for every call (BUY UP / BUY DOWN), fill, settlement result and HALT.
# Discord: Server Settings > Integrations > Webhooks > New Webhook > Copy Webhook URL. Treat it like a password.
DISCORD_WEBHOOK_URL=

# Optional
PAPER_BANKROLL=1000
DB_PATH=btc15.db
KILL_FILE=KILL
